# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - CONSUR S.A.
# Copiar este archivo como .env en el VPS y completar los valores secretos.
# ==============================================================================

APP_NAME="CONSUR S.A."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://consur.com.py

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# Configuración de Mantenimiento y Rendimiento
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

# Logs de Producción
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base de Datos de Producción (MySQL / MariaDB o PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=consur_prod
DB_USERNAME=consur_user
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI

# Sesiones Seguras (Protegidas por HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=consur.com.py
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Caché y Colas en Segundo Plano
CACHE_STORE=database
QUEUE_CONNECTION=database

# Almacenamiento de Archivos
FILESYSTEM_DISK=public

# Cloudflare Turnstile Anti-Bot
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Servidor de Correo (SMTP Oficial)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@consur.com.py
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notificaciones@consur.com.py"
MAIL_FROM_NAME="CONSUR S.A."

# Vite
VITE_APP_NAME="${APP_NAME}"

